# Gmail Configuration for Invitation System
# Follow the GMAIL_SETUP.md guide to set these up

# Your Gmail address
GMAIL_USER=your-email@gmail.com

# Gmail App Password (16 characters, NOT your regular password)
# Get this from Google Account Settings > Security > App Passwords
GMAIL_APP_PASSWORD=your-app-password-here

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# Database connection (if needed)
# MONGODB_URI=mongodb://localhost:27017/unimatch

# JWT Secret (if needed)
# JWT_SECRET=your-jwt-secret-here

# Port configuration
PORT=5000
